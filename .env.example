# Frontend optional backend mode.
# Leave empty to keep the Vue prototype in local mock mode.
VITE_AGENT_DESK_API_BASE_URL=http://localhost:18080

# Browser localStorage keys used when backend mode is enabled:
# agentDesk.api.baseUrl=<optional runtime backend URL override>
# agentDesk.api.accessToken=<JWT access token from Spring auth>
# agentDesk.api.refreshToken=<refresh token from Spring auth>
# agentDesk.api.projectId=<project UUID from Spring auth/register or auth/me>
# agentDesk.api.userEmail=<signed-in email for UI display>
# agentDesk.api.userName=<signed-in name for UI display>
